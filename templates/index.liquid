{% section 'hero' %}

<div class="collections-container" style="max-width: {{ settings.container_width }}px; margin: 0 auto; padding: var(--section-spacing, 40px) 20px;">
  <h2 class="text-center mb-4">Featured Collections</h2>
  
  <div class="collections-grid">
    {% for collection in collections limit: 4 %}
      <div class="collection-card">
        {% if collection.featured_image %}
          <img src="{{ collection.featured_image | image_url: width: 400 }}" alt="{{ collection.title }}" class="collection-image" />
        {% endif %}
        <h3 class="mt-3">{{ collection.title }}</h3>
        <p>{{ collection.description | strip_html | truncatewords: 10 }}</p>
        <a href="{{ collection.url }}" class="btn btn-primary mt-3">Shop {{ collection.title }}</a>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
  }
  
  .collection-card {
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
  }
  
  .collection-card:hover {
    transform: translateY(-5px);
  }
  
  .collection-image {
    width: 100%;
    height: 250px;
    object-fit: cover;
  }
  
  .collection-card h3 {
    padding: 0 16px;
    font-size: 18px;
  }
  
  .collection-card p {
    padding: 0 16px;
    color: #666;
    font-size: 14px;
  }
  
  .collection-card .btn {
    margin: 16px;
  }
</style>
